{
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "type": "AdaptiveCard",
  "version": "1.2",
  "body": [
    {
      "type": "TextBlock",
      "text": "mokviaへ取り込む",
      "weight": "Bolder"
    },
    {
      "type": "TextBlock",
      "text": "保存先",
      "wrap": true
    },
    {
      "type": "Input.ChoiceSet",
      "id": "destination",
      "style": "expanded",
      "value": "inbox",
      "choices": [
        {
          "title": "Inbox（あとで整理）",
          "value": "inbox"
        },
        {
          "title": "今日（受理日の日本時間）",
          "value": "today"
        }
      ]
    },
    {
      "type": "TextBlock",
      "text": "Task名（必須、300文字以内）",
      "wrap": true
    },
    {
      "type": "Input.Text",
      "id": "title",
      "maxLength": 300
    },
    {
      "type": "TextBlock",
      "text": "任意のメモ（引用として保存、8000文字以内）",
      "wrap": true
    },
    {
      "type": "Input.Text",
      "id": "body",
      "isMultiline": true,
      "maxLength": 8000
    },
    {
      "type": "TextBlock",
      "text": "明示された締切がある場合のみ（任意）",
      "wrap": true
    },
    {
      "type": "Input.Date",
      "id": "due"
    }
  ],
  "actions": [
    {
      "type": "Action.Submit",
      "title": "取り込む"
    }
  ]
}
